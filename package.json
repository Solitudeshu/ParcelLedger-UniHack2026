{
  "name": "unihack26-kien-chung",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/evidence-schema",
    "packages/api-client"
  ],
  "scripts": {
    "start": "node scripts/start-web.mjs",
    "dev": "npm run dev --workspace @kien-chung/web",
    "build": "npm run build --workspace @kien-chung/web",
    "typecheck": "npm run typecheck --workspace @kien-chung/web",
    "test:schemas": "node --import tsx --test tests/schema/*.test.ts",
    "generate:client": "openapi-typescript artifacts/manifests/openapi.json -o packages/api-client/src/schema.d.ts",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@foundry-rs/anvil-win32-amd64": "1.7.1",
    "@foundry-rs/forge-win32-amd64": "1.7.1"
  }
}
