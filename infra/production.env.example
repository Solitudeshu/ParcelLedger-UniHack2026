# Copy outside source control, populate on the deployment host; never paste secrets in chat.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
WEB_ORIGIN=https://YOUR-REAL-HOSTNAME
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://YOUR-S3-ENDPOINT
S3_REGION=us-east-1
S3_BUCKET=YOUR-PRIVATE-EVIDENCE-BUCKET
S3_ACCESS_KEY=REPLACE-WITH-DEDICATED-KEY
S3_SECRET_KEY=REPLACE-WITH-DEDICATED-SECRET
# Start with API uploads; enable direct uploads only after configuring bucket CORS.
PRESIGNED_UPLOADS_ENABLED=false
S3_PUBLIC_ENDPOINT_URL=
CHAIN_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
SHADOW_RANKER_PATH=
SHADOW_CHANGE_PATH=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
